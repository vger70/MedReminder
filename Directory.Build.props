<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NeutralLanguage>en</NeutralLanguage>
    <NoWarn>$(NoWarn);CA1848</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Repo layout">
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
  </PropertyGroup>

  <!-- Versione centralizzata: tutti gli assembly la ereditano tramite
       AssemblyVersion/FileVersion/InformationalVersion generati dal SDK.
       Bumpare qui a ogni release. -->
  <PropertyGroup Label="Versioning">
    <VersionPrefix>1.0.1</VersionPrefix>
    <!-- VersionSuffix opzionale: "beta", "rc1", "alpha.2" — produce
         ad esempio 1.0.1-beta. Lascia vuoto per una release finale. -->
    <VersionSuffix></VersionSuffix>
  </PropertyGroup>

</Project>
