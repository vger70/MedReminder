<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NeutralLanguage>en</NeutralLanguage>
    <NoWarn>$(NoWarn);CA1848</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Repo layout">
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
  </PropertyGroup>

  <!-- Centralized version: every assembly inherits it through
       AssemblyVersion / FileVersion / InformationalVersion generated
       by the SDK. Bump here for every release. -->
  <PropertyGroup Label="Versioning">
    <VersionPrefix>2.2.3</VersionPrefix>
    <!-- Optional VersionSuffix: "beta", "rc1", "alpha.2" — produces
         for example 1.0.1-beta. Leave empty for a final release. -->
    <VersionSuffix></VersionSuffix>
  </PropertyGroup>

  <!-- Assembly / package metadata inherited by every project. These
       values surface in the file properties of the shipped .exe
       ("Details" tab in Windows Explorer) and in the About dialog
       (which reads them via Assembly.GetCustomAttribute). Keep the
       repository URLs pointing at the canonical GitHub repository. -->
  <PropertyGroup Label="Assembly metadata">
    <Product>MedReminder</Product>
    <Authors>vger70</Authors>
    <Company>vger70</Company>
    <Copyright>Copyright (c) vger70. Licensed under the Apache License 2.0.</Copyright>
    <PackageProjectUrl>https://github.com/vger70/MedReminder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vger70/MedReminder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    Release-only cleanup: at the end of every Release build and publish,
    remove the debug symbols (*.pdb) and the XML documentation files
    (*.xml) from the output and publish folders. Keeps the shipped ZIP /
    MSI / MSIX free of debug and documentation noise.

    Scoped by Configuration == Release so Debug builds keep their .pdb
    and .xml files intact.

    Test projects are excluded: they never ship, and their .pdb files
    are useful when a test fails locally.
  -->
  <Target Name="StripReleaseDebugArtifacts"
          AfterTargets="Build;Publish"
          Condition="'$(Configuration)' == 'Release' and '$(IsTestProject)' != 'true' and !$(MSBuildProjectName.EndsWith('.Tests'))">
    <ItemGroup>
      <_ReleaseArtifactsToStrip Include="$(OutputPath)**\*.pdb" />
      <_ReleaseArtifactsToStrip Include="$(OutputPath)**\*.xml" />
      <_ReleaseArtifactsToStrip Include="$(PublishDir)**\*.pdb" Condition="'$(PublishDir)' != ''" />
      <_ReleaseArtifactsToStrip Include="$(PublishDir)**\*.xml" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_ReleaseArtifactsToStrip)"
            TreatErrorsAsWarnings="true"
            ContinueOnError="true" />
    <Message Importance="high"
             Text="StripReleaseDebugArtifacts: removed *.pdb and *.xml from $(OutputPath) and $(PublishDir)"
             Condition="'@(_ReleaseArtifactsToStrip)' != ''" />
  </Target>

</Project>
