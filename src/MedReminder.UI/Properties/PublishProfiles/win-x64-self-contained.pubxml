<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile self-contained per Windows x64.
  Include il runtime .NET 10 nel pacchetto: nessuna installazione
  necessaria sulla macchina di destinazione. Output più grande
  (~70-90 MB) ma completamente autonomo.

  PublishTrimmed=false: WinForms ed EF Core usano reflection estesa,
  il trimming non è sicuro e romperebbe la app.

  Utilizzo:
    dotnet publish src/MedReminder.UI -c Release ^
      /p:PublishProfile=win-x64-self-contained
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0-windows10.0.19041.0\publish\win-x64-sc\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <!-- Deve corrispondere ESATTAMENTE al TargetFramework del csproj
         (net10.0-windows10.0.19041.0). Se scriviamo solo
         "net10.0-windows" il SDK degrada TargetPlatformVersion a 7.0
         e SupportedOSPlatformVersion=10.0.17763.0 diventa incompatibile
         (errore NETSDK1135). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
