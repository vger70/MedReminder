<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained publish profile for Windows x64.
  Bundles the .NET 10 runtime inside the package: no installation
  required on the target machine. Larger output (~70-90 MB) but fully
  standalone.

  PublishTrimmed=false: WinForms and EF Core use extensive reflection;
  trimming is not safe and would break the app.

  Usage:
    dotnet publish src/MedReminder.UI -c Release ^
      /p:PublishProfile=win-x64-self-contained
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0-windows10.0.19041.0\publish\win-x64-sc\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <!-- Must EXACTLY match the TargetFramework of the csproj
         (net10.0-windows10.0.19041.0). If we write only
         "net10.0-windows", the SDK degrades TargetPlatformVersion to
         7.0 and SupportedOSPlatformVersion=10.0.17763.0 becomes
         incompatible (NETSDK1135 error). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
