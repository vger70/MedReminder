<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile framework-dependent per Windows x64.
  Richiede che la macchina di destinazione abbia il runtime .NET 10
  Desktop installato. Output più leggero (~5-10 MB); adatto se l'utente
  installa già altre app .NET.

  Utilizzo:
    dotnet publish src/MedReminder.UI -c Release ^
      /p:PublishProfile=win-x64-framework-dependent
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0-windows10.0.19041.0\publish\win-x64-fx\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <!-- Deve corrispondere ESATTAMENTE al TargetFramework del csproj
         (net10.0-windows10.0.19041.0). Se scriviamo solo
         "net10.0-windows" il SDK degrada TargetPlatformVersion a 7.0
         e SupportedOSPlatformVersion=10.0.17763.0 diventa incompatibile
         (errore NETSDK1135). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
