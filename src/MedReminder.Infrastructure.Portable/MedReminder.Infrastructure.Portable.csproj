<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral infrastructure (docs/analysis/ANALYSIS-B1-MOBILE-SYNC.md
    §4.1, §13 Phase 1): EF Core persistence, the encrypted-archive cipher and
    reader, and the localization loader. Shared by the Windows desktop
    (MedReminder.Infrastructure) and the future mobile host. Must not
    reference Windows APIs, WinForms, DPAPI, the registry or
    %LOCALAPPDATA%; paths come from IAppDataLocation or explicit
    arguments. Namespaces stay MedReminder.Infrastructure.* (decision D9).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MedReminder.Infrastructure</RootNamespace>
    <AssemblyName>MedReminder.Infrastructure.Portable</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <!-- Argon2id KDF for the encrypted export archive (C.3,
         docs/analysis/ANALYSIS-C3-EXPORT-IMPORT.md §3.3). Managed,
         MIT, no native dependency. AES-GCM comes from the in-box
         System.Security.Cryptography.AesGcm. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MedReminder.Domain\MedReminder.Domain.csproj" />
    <ProjectReference Include="..\MedReminder.Application\MedReminder.Application.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);IDE0011</NoWarn>
  </PropertyGroup>

</Project>
