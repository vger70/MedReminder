<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for MedReminder.

  Identity/Publisher: MUST EXACTLY match the Subject of the
  certificate used to sign the .msix, otherwise the install fails
  with SIGNATURE_INVALID / PUBLISHER_MISMATCH. Replace before
  publishing:

    Publisher="CN=<your CA-verified name>, O=<org>, C=<country>"

  For development with the self-signed generated by
  make-selfsigned-cert.ps1 the default is:
  CN=vger70 Development, O=vger70, C=IT.

  runFullTrust: WinForms + HKCU\Run registry + DPAPI + tray icon +
  WebView2 all require full trust. Without this capability the app
  cannot run as an MSIX package. Do not abuse it: it is a
  restricted but legitimate capability for classic desktop apps.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap5 rescap">

  <Identity
      Name="vger70.MedReminder"
      Publisher="CN=vger70 Development, O=vger70, C=IT"
      Version="1.0.1.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MedReminder</DisplayName>
    <PublisherDisplayName>vger70</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Organizational reminder for medication stock run-out. NOT a medical device.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="it-it" />
    <Resource Language="fr-fr" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="MedReminder"
                 Executable="MedReminder.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="MedReminder"
          Description="Organizational reminder for medication stock"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            Wide310x150Logo="Assets\Wide310x150Logo.png"
            Square71x71Logo="Assets\Square71x71Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0D47A1" />
      </uap:VisualElements>

      <Extensions>
        <!-- Executable alias: lets the app be launched from cmd too. -->
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="medreminder.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
