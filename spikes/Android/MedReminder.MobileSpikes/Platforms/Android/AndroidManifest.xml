<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- No backup: the spike writes a scratch database only. -->
  <application android:allowBackup="false" android:supportsRtl="true" android:label="MedReminder Spikes" />
  <!-- The file picker for S1b goes through the system document picker;
       older versions may still ask for read access. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
</manifest>
